generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id           String   @id @default(uuid())
  services     String[]
  goals        String
  features     String[]
  scope_notes  String
  timeline     String
  budget_range String
  name         String
  company      String
  email        String
  phone        String
  location     String
  consent      Boolean
  created_at   DateTime @default(now())

  @@index([created_at])
  @@index([email])
}
